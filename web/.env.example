# All optional — AnyDrop runs with none of these set.

# --- yt-dlp ---------------------------------------------------------------
# Path to the yt-dlp binary. Default: ./bin/yt-dlp if python3 is on PATH,
# else ./bin/yt-dlp_linux, else `yt-dlp` on PATH. (TikTok always uses
# ./bin/yt-dlp_linux.)
# YT_DLP_PATH=
# Kill a resolve that hangs longer than this (ms).
# RESOLVER_TIMEOUT_MS=30000
# Route every yt-dlp request through a proxy. The platforms throttle
# datacenter IPs much more than home connections — this is the fix when
# resolves work locally but fail on the server.
# YT_DLP_PROXY=http://user:pass@proxy.example:8080

# --- ffmpeg -----------------------------------------------------------------
# Enables the highest-quality ("HQ", merged video+audio) downloads and MP3
# extraction. Default: ./bin/ffmpeg if present, else `ffmpeg` on PATH
# (`apt install ffmpeg` on a VPS). Without ffmpeg those options are simply
# not offered.
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- downloads ----------------------------------------------------------------
# A streaming download is cut off after this long with no data (ms) — an
# inactivity timeout, so long videos that keep streaming are never cut.
# DOWNLOAD_TIMEOUT_MS=45000

# --- caching / rate limiting ------------------------------------------------
# Reuse a successful resolve for this long (ms); 0 disables.
# RESOLVE_CACHE_TTL_MS=300000
# RESOLVE_CACHE_MAX=200
# RATE_LIMIT_WINDOW_MS=60000
# Max /resolve requests per window per IP (/download allows 2x).
# RATE_LIMIT_MAX=20
